{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/pyramid-task/baseline.schema.json",
  "title": "Pyramid Task Brownfield Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "baseline_id", "revision", "status", "captured_at", "captured_by", "capture_method", "assets", "relations", "history", "unknowns"],
  "properties": {
    "schema": {"const": "pyramid-baseline-v1"},
    "baseline_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["incomplete", "current", "stale"]},
    "captured_at": {"type": "string"},
    "captured_by": {"type": "string", "minLength": 1},
    "capture_method": {"type": "string", "minLength": 1},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "history": {"type": "array", "items": {"$ref": "#/$defs/history"}},
    "unknowns": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "locators", "owner", "criticality", "confidence", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["repository", "service", "module", "api", "data-store", "job", "deployment", "interface", "runbook", "external-system", "repository-area", "unknown"]},
        "name": {"type": "string", "minLength": 1},
        "locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclude_locators": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "owner": {"type": "string"},
        "criticality": {"enum": ["unknown", "low", "medium", "high", "critical"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evidence": {"$ref": "#/$defs/strings"}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type", "evidence"],
      "properties": {
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "type": {"enum": ["depends-on", "calls", "reads", "writes", "publishes", "subscribes", "deployed-with", "guarded-by", "observed-by", "owned-by"]},
        "evidence": {"$ref": "#/$defs/strings"}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "asset_ids", "evidence", "date", "controls"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["incident", "defect", "migration", "decision", "workaround", "change"]},
        "summary": {"type": "string", "minLength": 1},
        "asset_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "evidence": {"$ref": "#/$defs/strings"},
        "date": {"type": "string"},
        "controls": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
