{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/pyramid-task/history-transaction.schema.json",
  "title": "Pyramid Task History Append Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "prepared_at",
    "record",
    "record_sha256",
    "entry",
    "previous_chain_sha256",
    "next_head"
  ],
  "properties": {
    "schema": {"const": "pyramid-history-transaction-v1"},
    "operation": {"const": "append"},
    "prepared_at": {"type": "string", "minLength": 1},
    "record": {
      "type": "object",
      "required": ["schema", "record_id", "record_type", "plan_id", "recorded_at", "recorded_by"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$"},
        "record_type": {"enum": ["intent-start", "intent-chronicle", "code-binding"]},
        "plan_id": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "minLength": 1},
        "recorded_by": {"type": "string", "minLength": 1}
      }
    },
    "record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entry": {"$ref": "#/$defs/entry"},
    "previous_chain_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "next_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "updated_at", "entries", "chain_sha256"],
      "properties": {
        "schema": {"const": "pyramid-history-head-v1"},
        "updated_at": {"type": "string", "minLength": 1},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
        "chain_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "record_type", "plan_id", "recorded_at", "path", "sha256", "previous_chain_sha256"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$"},
        "record_type": {"enum": ["intent-start", "intent-chronicle", "code-binding"]},
        "plan_id": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^records/[^/]+\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "previous_chain_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
