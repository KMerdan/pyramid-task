{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/pyramid-task/assurance.schema.json",
  "title": "Pyramid Task Change Assurance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "baseline_id", "baseline_revision", "policy", "status", "updated_at", "updated_by", "enforce_from_graph_version", "impacts", "inspections", "findings", "scope_drift", "controls", "legacy_bridge", "stale_reasons"],
  "properties": {
    "schema": {"const": "pyramid-assurance-v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "baseline_id": {"$ref": "#/$defs/id"},
    "baseline_revision": {"type": "integer", "minimum": 1},
    "policy": {"enum": ["brownfield", "legacy-bridge"]},
    "status": {"enum": ["incomplete", "ready", "stale", "passed"]},
    "updated_at": {"type": "string"},
    "updated_by": {"type": "string", "minLength": 1},
    "enforce_from_graph_version": {"type": "integer", "minimum": 1},
    "impacts": {"type": "array", "items": {"$ref": "#/$defs/impact"}},
    "inspections": {"type": "array", "items": {"$ref": "#/$defs/inspection"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "scope_drift": {"type": "array", "items": {"$ref": "#/$defs/drift"}},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollback", "monitoring"],
      "properties": {"rollback": {"$ref": "#/$defs/control"}, "monitoring": {"$ref": "#/$defs/control"}}
    },
    "legacy_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "gap_asset_ids", "evidence", "upgraded_from"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not-required", "pending", "sufficient", "documented"]},
        "gap_asset_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "evidence": {"$ref": "#/$defs/strings"},
        "upgraded_from": {"type": ["string", "null"]}
      }
    },
    "stale_reasons": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_id", "task_ids", "type", "status", "confidence", "evidence", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "asset_id": {"$ref": "#/$defs/id"},
        "task_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "type": {"enum": ["direct", "transitive", "data", "operational", "security", "compliance"]},
        "status": {"enum": ["hypothesis", "confirmed", "dismissed"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "evidence": {"$ref": "#/$defs/strings"}, "path": {"$ref": "#/$defs/strings"}
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_ids", "task_ids", "method", "required", "status", "result", "sufficiency", "evidence", "limitations", "performed_at", "performed_by"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "asset_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "task_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "method": {"type": "string", "minLength": 1}, "required": {"type": "boolean"},
        "status": {"enum": ["planned", "performed", "blocked", "skipped", "stale"]},
        "result": {"enum": ["pass", "fail", "inconclusive", "not-run"]},
        "sufficiency": {"enum": ["sufficient", "partial", "insufficient", "unknown"]},
        "evidence": {"$ref": "#/$defs/strings"}, "limitations": {"$ref": "#/$defs/strings"},
        "performed_at": {"type": ["string", "null"]}, "performed_by": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_ids", "inspection_id", "title", "severity", "status", "evidence", "accepted_by", "acceptance_reason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "asset_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "inspection_id": {"type": ["string", "null"]}, "title": {"type": "string", "minLength": 1},
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "status": {"enum": ["open", "resolved", "accepted", "dismissed"]},
        "evidence": {"$ref": "#/$defs/strings"}, "accepted_by": {"type": ["string", "null"]},
        "acceptance_reason": {"type": ["string", "null"]}
      }
    },
    "drift": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "task", "changed_file", "matched_asset_ids", "status", "detected_at", "resolved_impact_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "task": {"$ref": "#/$defs/id"}, "changed_file": {"type": "string", "minLength": 1},
        "matched_asset_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "status": {"enum": ["open", "resolved"]},
        "detected_at": {"type": "string"}, "resolved_impact_id": {"type": ["string", "null"]}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false, "required": ["status", "evidence", "rationale"],
      "properties": {"status": {"enum": ["ready", "missing", "not-applicable"]}, "evidence": {"$ref": "#/$defs/strings"}, "rationale": {"type": "string"}}
    }
  }
}
