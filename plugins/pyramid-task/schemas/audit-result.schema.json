{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/pyramid-task/audit-result.schema.json",
  "title": "Pyramid Task Audit Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "result", "checks", "affected_claims", "recommended_action"],
  "properties": {
    "schema": {"const": "audit-result-v1"},
    "target": {"type": "string"},
    "result": {"enum": ["pass", "fail"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result", "evidence"],
        "properties": {"id": {"type": "string"}, "result": {"enum": ["passed", "failed"]}, "evidence": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "affected_claims": {"type": "array", "items": {"type": "string"}},
    "recommended_action": {"enum": ["advance", "repair", "expand", "replan", "block"]},
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact_ids", "inspection_ids", "finding_ids", "scope_review", "limitations"],
      "properties": {
        "impact_ids": {"type": "array", "items": {"type": "string"}},
        "inspection_ids": {"type": "array", "items": {"type": "string"}},
        "finding_ids": {"type": "array", "items": {"type": "string"}},
        "scope_review": {"enum": ["complete", "incomplete"]},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
