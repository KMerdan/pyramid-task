{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/pyramid-task/audit-result.schema.json",
  "title": "Pyramid Task Audit Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "result",
    "affected_claims",
    "recommended_action"
  ],
  "properties": {
    "schema": {
      "const": "audit-result-v1"
    },
    "target": {
      "type": "string"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "affected_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_action": {
      "enum": [
        "advance",
        "repair",
        "expand",
        "replan",
        "block"
      ]
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impact_ids",
        "inspection_ids",
        "finding_ids",
        "scope_review",
        "limitations"
      ],
      "properties": {
        "impact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inspection_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_review": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement",
              "run"
            ],
            "properties": {
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "run": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contract_sha256",
                  "inputs_sha256",
                  "environment",
                  "observations"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^RUN-[A-F0-9]{32}$"
                  },
                  "contract_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "inputs_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "environment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observations": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "result",
                        "summary",
                        "reviewer",
                        "artifacts"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "external",
                            "internal",
                            "visual"
                          ]
                        },
                        "result": {
                          "const": "passed"
                        },
                        "summary": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reviewer": {
                          "type": "string",
                          "minLength": 1
                        },
                        "artifacts": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 16,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "path",
                              "sha256"
                            ],
                            "properties": {
                              "path": {
                                "type": "string",
                                "minLength": 1
                              },
                              "sha256": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement",
              "reuse_run"
            ],
            "properties": {
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "reuse_run": {
                "type": "string",
                "pattern": "^RUN-[A-F0-9]{32}$"
              }
            }
          }
        ]
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "checks"
      ]
    },
    {
      "required": [
        "proofs"
      ]
    }
  ]
}
