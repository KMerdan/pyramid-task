{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/pyramid-task/history-index.schema.json",
  "title": "Pyramid Task Generated History Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_at", "chronicles", "files", "commits"],
  "properties": {
    "schema": {"const": "pyramid-history-index-v1"},
    "generated_at": {"type": "string"},
    "chronicles": {"type": "array", "items": {"type": "object"}},
    "files": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "commits": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}
  }
}
