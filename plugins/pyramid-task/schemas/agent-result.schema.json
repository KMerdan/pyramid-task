{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/pyramid-task/agent-result.schema.json",
  "title": "Pyramid Task Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task",
    "outcome",
    "changed_files",
    "discovered_risks",
    "suggested_graph_changes"
  ],
  "properties": {
    "schema": {
      "const": "agent-result-v1"
    },
    "task": {
      "type": "string"
    },
    "outcome": {
      "const": "implemented"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_effect": {
      "enum": [
        "source-change",
        "evidence-only",
        "mixed"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "class"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "source",
              "generated",
              "runtime",
              "configuration",
              "evidence",
              "unknown"
            ]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not-run"
            ]
          }
        }
      }
    },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "result",
          "reference"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "reference": {
            "type": "string"
          }
        }
      }
    },
    "discovered_risks": {
      "type": "array"
    },
    "suggested_graph_changes": {
      "type": "array"
    },
    "changed_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement",
              "run"
            ],
            "properties": {
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "run": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contract_sha256",
                  "inputs_sha256",
                  "environment",
                  "observations"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^RUN-[A-F0-9]{32}$"
                  },
                  "contract_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "inputs_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "environment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "observations": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "result",
                        "summary",
                        "reviewer",
                        "artifacts"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "external",
                            "internal",
                            "visual"
                          ]
                        },
                        "result": {
                          "const": "passed"
                        },
                        "summary": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reviewer": {
                          "type": "string",
                          "minLength": 1
                        },
                        "artifacts": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 16,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "path",
                              "sha256"
                            ],
                            "properties": {
                              "path": {
                                "type": "string",
                                "minLength": 1
                              },
                              "sha256": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement",
              "reuse_run"
            ],
            "properties": {
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "reuse_run": {
                "type": "string",
                "pattern": "^RUN-[A-F0-9]{32}$"
              }
            }
          }
        ]
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "checks",
        "acceptance_evidence"
      ]
    },
    {
      "required": [
        "proofs"
      ]
    }
  ]
}
