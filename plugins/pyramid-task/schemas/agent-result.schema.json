{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/pyramid-task/agent-result.schema.json",
  "title": "Pyramid Task Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task", "outcome", "changed_files", "checks", "acceptance_evidence", "discovered_risks", "suggested_graph_changes"],
  "properties": {
    "schema": {"const": "agent-result-v1"},
    "task": {"type": "string"},
    "outcome": {"const": "implemented"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "change_effect": {"enum": ["source-change", "evidence-only", "mixed"]},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "class"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "class": {"enum": ["source", "generated", "runtime", "configuration", "evidence", "unknown"]}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "result"],
        "properties": {"command": {"type": "string"}, "result": {"enum": ["passed", "failed", "not-run"]}}
      }
    },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "result", "reference"],
        "properties": {"criterion": {"type": "string"}, "result": {"enum": ["passed", "failed"]}, "reference": {"type": "string"}}
      }
    },
    "discovered_risks": {"type": "array"},
    "suggested_graph_changes": {"type": "array"},
    "changed_assets": {"type": "array", "items": {"type": "string"}}
  }
}
