{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/pyramid-task/final-report.schema.json",
  "title": "Pyramid Task Final Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "title", "revision", "graph_version", "completed_at", "completed_by", "intent", "success_evidence", "verified_primary_nodes", "decisions", "evidence", "residual_risks"],
  "properties": {
    "schema": {"const": "pyramid-final-report-v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "graph_version": {"type": "integer", "minimum": 1},
    "completed_at": {"type": "string"},
    "completed_by": {"type": "string", "minLength": 1},
    "intent": {"type": "object"},
    "success_evidence": {"type": "array", "items": {"type": "object"}},
    "verified_primary_nodes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "decisions": {"type": "array"},
    "evidence": {"type": "array"},
    "residual_risks": {"type": "array", "items": {"type": "string"}}
  }
}
